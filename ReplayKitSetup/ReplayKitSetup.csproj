<Project Sdk="Microsoft.NET.Sdk">
  <!-- generated by utils\sync_version.ps1 (build.bat step 1) from VersionInfo.cs; gitignored, same as version.json.
       falls back to a plain 0.0.0 build below if this hasnt been generated yet, e.g. a raw `dotnet build` that
       skipped build.bat; the project still compiles, it just wont carry a real version until sync runs. -->
  <Import Project="..\Version.props" Condition="Exists('..\Version.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReplayKitSetup</RootNamespace>
    <AssemblyName>OBSReplayKit</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- must stay x64, not AnyCPU: VoiceMeeter.cs loads VoicemeeterRemote64.dll, which a 32-bit process cannot load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\utils\icon\obs-replaykit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 version resource; unset, this exe shipped as CompanyName "OBSReplayKit" (just the assembly name),
         FileVersion 1.0.0.0 regardless of the real release, and an auto-generated "1.0.0+<git-hash>" informational
         version, all of which read as an unmaintained, machine-generated binary rather than a real application to
         some antivirus heuristics; unsigned + version-less is a much easier "generic trojan" call than unsigned
         + a normal-looking release. swap Company for a real name/handle if you have one you prefer. -->
    <Product>OBS ReplayKit</Product>
    <Company>OBS ReplayKit</Company>
    <Description>OBS ReplayKit installer and updater</Description>
    <Copyright>Copyright (c) OBS ReplayKit contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- merges every referenced dll (Newtonsoft.Json.dll) into OBSReplayKit.exe so the shipped artifact is a single file. the package's own AfterTargets="Build" step handles plain `dotnet build`, but `dotnet publish` recomputes its file list from the project's dependency graph independently of whatever Build already did to bin/, so it re-copies a fresh Newtonsoft.Json.dll into the publish folder regardless; ILRepackPublish below re-merges the actual publish output to fix that. -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- assets\ ships inside the exe as one zip resource, unpacked at runtime by AssetBundle.cs. the auto-updater downloads only OBSReplayKit.exe and runs it from %temp%, so a build whose payload lives in a sibling folder closes obs and then finds nothing to install. staged into obj\ first because the working tree can hold per-user runtime folders (imported icons, saved themes) that must never ship. -->
    <AssetBundleSourceDir>$(MSBuildProjectDirectory)\..\assets</AssetBundleSourceDir>
    <!-- obj\ spelled out rather than $(IntermediateOutputPath): this target runs before PrepareForBuild, where that property is not resolved yet and the staging would land in the project folder. -->
    <AssetBundleStageDir>$(MSBuildProjectDirectory)\obj\assets-bundle\</AssetBundleStageDir>
    <AssetBundleZip>$(MSBuildProjectDirectory)\obj\assets.bundle.zip</AssetBundleZip>
  </PropertyGroup>

  <Target Name="PackAssetBundle" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <AssetBundleFile Include="$(AssetBundleSourceDir)\**\*" Exclude="$(AssetBundleSourceDir)\obs-studio\obs-replayKit\icons\user\**\*;$(AssetBundleSourceDir)\obs-studio\obs-replayKit\themes-user\**\*;$(AssetBundleSourceDir)\obs-studio\obs-replayKit\obs-custom-dock\rk-theme.css" />
    </ItemGroup>
    <Error Condition="'@(AssetBundleFile)' == ''" Text="No files under $(AssetBundleSourceDir) -- the release exe would ship with no runtime payload." />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <Copy SourceFiles="@(AssetBundleFile)" DestinationFiles="@(AssetBundleFile->'$(AssetBundleStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(AssetBundleStageDir)" DestinationFile="$(AssetBundleZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(AssetBundleZip)" LogicalName="ReplayKitSetup.assets.bundle.zip" />
    </ItemGroup>
  </Target>

  <Target Name="ILRepackPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedAssemblies Include="$(PublishDir)$(TargetName)$(TargetExt)" />
      <PublishedAssemblies Include="$(PublishDir)*.dll" Exclude="$(PublishDir)$(TargetName)$(TargetExt)" />
      <PublishedDllsToRemove Include="$(PublishDir)*.dll" Exclude="$(PublishDir)$(TargetName)$(TargetExt)" />
    </ItemGroup>
    <ILRepack
        Parallel="true"
        DebugInfo="false"
        AllowDuplicateResources="false"
        InputAssemblies="@(PublishedAssemblies)"
        TargetKind="SameAsPrimaryAssembly"
        OutputFile="$(PublishDir)$(TargetName)$(TargetExt)"
    />
    <Delete Files="@(PublishedDllsToRemove)" />
  </Target>
</Project>
