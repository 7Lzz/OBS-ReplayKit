<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by utils/sync_version.ps1 from VersionInfo.cs before release builds. -->
  <Import Project="..\Version.props" Condition="Exists('..\Version.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ReplayKitSetup</RootNamespace>
    <AssemblyName>OBSReplayKit</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- must stay x64, not AnyCPU: VoiceMeeter.cs loads VoicemeeterRemote64.dll, which a 32-bit process cannot load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\utils\icon\obs-replaykit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Runtime, managed dependencies, and assets are contained in the installer. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- partial trim takes the exe from ~44 mb to ~24 mb. it only trims bcl assemblies that opt in; Newtonsoft.Json,
         ServiceController and Registry are root-kept below so their reflection/interop paths stay whole. the ~5 wmi
         sites were already moved off System.Management (registry + Process api), so nothing here needs full trim. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- library-origin trim warnings, none of it reachable code here: IL2104 = Newtonsoft.Json produced warnings
         (partial trim leaves it whole anyway), IL2026 = the System.Data DataSet/DataTable xml paths Newtonsoft drags
         in plus the built-in COM activator. the WScript.Shell late-bound COM in Startup.cs carries its own suppress. -->
    <NoWarn>$(NoWarn);IL2104;IL2026</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- no icu. this project has zero CultureInfo use and only ever compares/formats invariant ascii (obs config
         keys, file paths, version strings), so dropping the ~24 mb icu payload is behaviour-neutral here. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- diagnostic infrastructure an installer never uses. shaves a few mb and does not touch exception messages or
         stack traces, both of which Program.cs writes to OBSReplayKit-error.log for user crash reports. -->
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- line numbers still land in the crash log without a loose .pdb file next to the exe. -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/ReplayKitSetup</PathMap>
    <!-- Product metadata for the installer. -->
    <Product>OBS ReplayKit</Product>
    <Company>OBS ReplayKit</Company>
    <Description>OBS ReplayKit installer and updater</Description>
    <Copyright>Copyright (c) OBS ReplayKit contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- windows-only, not in the net8 shared framework; backs VbCable.cs's AudioEndpointBuilder/Audiosrv bounce. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- keep whole under trimming: the linker cannot see through Newtonsoft's reflection, and ServiceController plus
         Registry are small advapi32-interop assemblies where a trimmed member would only surface at runtime mid-install. -->
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="System.ServiceProcess.ServiceController" />
    <TrimmerRootAssembly Include="Microsoft.Win32.Registry" />
  </ItemGroup>

  <PropertyGroup>
    <!-- assets\ ships inside the exe as one zip resource, unpacked at runtime by AssetBundle.cs; the auto-updater only
         fetches OBSReplayKit.exe, so a payload living anywhere else closes obs and then finds nothing to install.
         staged into obj\ first because the working tree can hold per-user runtime folders (imported icons, saved
         themes) that must never ship. -->
    <AssetBundleSourceDir>$(MSBuildProjectDirectory)\..\assets</AssetBundleSourceDir>
    <!-- obj\ spelled out rather than $(IntermediateOutputPath): this target runs before PrepareForBuild, where that property is not resolved yet and the staging would land in the project folder. -->
    <AssetBundleStageDir>$(MSBuildProjectDirectory)\obj\assets-bundle\</AssetBundleStageDir>
    <AssetBundleZip>$(MSBuildProjectDirectory)\obj\assets.bundle.zip</AssetBundleZip>
  </PropertyGroup>

  <Target Name="PackAssetBundle" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <AssetBundleFile Include="$(AssetBundleSourceDir)\**\*" Exclude="$(AssetBundleSourceDir)\obs-studio\obs-replayKit\icons\user\**\*;$(AssetBundleSourceDir)\obs-studio\obs-replayKit\themes-user\**\*;$(AssetBundleSourceDir)\obs-studio\obs-replayKit\obs-custom-dock\rk-theme.css;$(AssetBundleSourceDir)\**\*.pdb;$(AssetBundleSourceDir)\**\*.log;$(AssetBundleSourceDir)\**\auth.dat;$(AssetBundleSourceDir)\**\auth_cookies.txt;$(AssetBundleSourceDir)\**\cookies.txt;$(AssetBundleSourceDir)\**\helper_config.json;$(AssetBundleSourceDir)\**\clips_db.json;$(AssetBundleSourceDir)\**\clips_index.json" />
    </ItemGroup>
    <Error Condition="'@(AssetBundleFile)' == ''" Text="No files under $(AssetBundleSourceDir) -- the release exe would ship with no runtime payload." />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <Copy SourceFiles="@(AssetBundleFile)" DestinationFiles="@(AssetBundleFile->'$(AssetBundleStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(AssetBundleStageDir)" DestinationFile="$(AssetBundleZip)" Overwrite="true" />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <ItemGroup>
      <EmbeddedResource Include="$(AssetBundleZip)" LogicalName="ReplayKitSetup.assets.bundle.zip" />
    </ItemGroup>
  </Target>
</Project>
