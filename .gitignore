# python
__pycache__/
*.py[cod]
*$py.class

# dotnet build outputs (ReplayKitSetup, the c# port)
ReplayKitSetup/bin/
ReplayKitSetup/obj/

# build outputs (build.bat publishes ReplayKitSetup into the repo root as a single merged exe, same spot the old pyinstaller build used)
build/
dist/
/OBSReplayKit.exe
/OBSReplayKit.exe.sha256
/prefs.json
/test_update_mode.bat
*.spec

# private pyinstaller build with a locally-compiled bootloader, see build.bat -- rebuilt once per
# machine from pypi source, not committed, and never touches the shared global python environment
/utils/pyinstaller_local/

# regenerated from ReplayKitSetup/VersionInfo.cs by build.bat and by the installer at apply time -- not tracked so a version bump only ever touches VersionInfo.cs
/assets/obs-studio/obs-replayKit/version.json

# regenerated from ReplayKitSetup/VersionInfo.cs by build_launcher.ps1, see utils/launcher/OBSReplayKit.cs
/utils/launcher/AssemblyVersion.Generated.cs

# one-off smoke / scratch scripts
_smoke_test.py
scratch_*.py

# runtime state written by the installer or helper -- these live in the users appdata, but in case someone copies them into the repo by mistake, ignore them so credentials/cookie stores/per-user paths can never accidentally be committed.
helper_config.json
clips_db.json
auth.jar
cookies.txt
*.session
.env
.env.local

# backups created by the installer + cleanup script
obs-studio.bak.*/
obs-custom-dock.bak.*/

# logs
*.log
logs/

# editors / ides
.vscode/
.idea/
*.swp
*~
.claude/

# os clutter
Thumbs.db
desktop.ini
.DS_Store
