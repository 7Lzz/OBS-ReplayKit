# dotnet build outputs
ReplayKit/apps/setup/bin/
ReplayKit/apps/setup/obj/
ReplayKit/apps/helper/bin/
ReplayKit/apps/helper/obj/

# build.bat output: the release exe and its checksum land in build/, publish_tmp is its scratch folder (self-cleaned, ignored in case a build fails partway)
build/
ReplayKit/publish_tmp/
# prefs the installer writes next to itself when it runs from a checkout
/prefs.json

# regenerated from ReplayKit/version.json by build.bat and by the installer at apply time, so a version bump only ever touches ReplayKit/version.json
/ReplayKit/dist/version.json
# same regeneration, feeds the win32 version resource of both csproj files
/ReplayKit/Version.props
/ReplayKit/Bundle.props
# written from ReplayKit/shared/HelperEndpoint.cs and StateLayout.cs by scripts/sync_shared.ps1 on every build, so those values are only ever edited there
/ReplayKit/plugins/replaykit/src/core/shared_values.hpp
/ReplayKit/lua/shared_values.lua
/ReplayKit/ui/helper-endpoint.js

# runtime state the installer and helper write into the users appdata; ignored in case a live folder is ever copied into the repo, so credentials, cookies and per-user paths can never be committed
helper_config.json
clips_db.json
game_mappings.json
ReplayKit/resources/game-icons/
clips_index.json
compression_history.json
edit_drafts.json
deleted_history.json
profile_picture.png
notifications.json
window_state.ini
hotkey_capture_signal.json
auth.dat
auth.jar
auth_cookies.txt
cookies.txt
*.session
.env
.env.local

# custom app icons the user imports at runtime (converted .ico), written under the live icons/ folder
ReplayKit/resources/icons/user/
# custom themes the user saves at runtime
ReplayKit/resources/themes-user/
# theme stylesheet the helper generates for the file:// dock
ReplayKit/ui/rk-theme.css

# backups created by the installer + cleanup
obs-studio.bak.*/
obs-custom-dock.bak.*/

# logs
*.log
logs/

# editors / ides
.vscode/
.idea/
*.swp
*~
.claude/

# os clutter
Thumbs.db
desktop.ini
.DS_Store
