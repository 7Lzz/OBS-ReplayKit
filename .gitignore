# dotnet build outputs
ReplayKit/ReplayKitSetup/bin/
ReplayKit/ReplayKitSetup/obj/
ReplayKit/ReplayKitHelper/bin/
ReplayKit/ReplayKitHelper/obj/

# build.bat output: the release exe and its checksum land in build/, publish_tmp is its scratch folder (self-cleaned, ignored in case a build fails partway)
build/
ReplayKit/publish_tmp/
# prefs the installer writes next to itself when it runs from a checkout
/prefs.json

# regenerated from ReplayKitSetup/VersionInfo.cs by build.bat and by the installer at apply time, so a version bump only ever touches VersionInfo.cs
/ReplayKit/assets/obs-studio/obs-replayKit/version.json
# same regeneration, feeds the win32 version resource of both csproj files
/ReplayKit/Version.props

# runtime state the installer and helper write into the users appdata; ignored in case a live folder is ever copied into the repo, so credentials, cookies and per-user paths can never be committed
helper_config.json
clips_db.json
clips_index.json
edit_drafts.json
notifications.json
window_state.ini
hotkey_capture_signal.json
auth.dat
auth.jar
auth_cookies.txt
cookies.txt
*.session
.env
.env.local

# custom app icons the user imports at runtime (converted .ico), written under the live icons/ folder
ReplayKit/assets/obs-studio/obs-replayKit/icons/user/
# custom themes the user saves at runtime
ReplayKit/assets/obs-studio/obs-replayKit/themes-user/
# theme stylesheet the helper generates for the file:// dock
ReplayKit/assets/obs-studio/obs-replayKit/obs-custom-dock/rk-theme.css

# backups created by the installer + cleanup
obs-studio.bak.*/
obs-custom-dock.bak.*/

# logs
*.log
logs/

# editors / ides
.vscode/
.idea/
*.swp
*~
.claude/

# os clutter
Thumbs.db
desktop.ini
.DS_Store
