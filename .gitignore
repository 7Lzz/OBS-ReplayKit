# python
__pycache__/
*.py[cod]
*$py.class

# pyinstaller build outputs
build/
dist/
/OBSReplayKit.exe
/OBSReplayKit.exe.sha256
/prefs.json
/test_update_mode.bat
*.spec

# one-off smoke / scratch scripts
_smoke_test.py
scratch_*.py

# runtime state written by the installer or helper -- these live in the users appdata, but in case someone copies them into the repo by mistake, ignore them so credentials/cookie stores/per-user paths can never accidentally be committed.
helper_config.json
clips_db.json
auth.jar
cookies.txt
*.session
.env
.env.local

# backups created by the installer + cleanup script
obs-studio.bak.*/
obs-custom-dock.bak.*/

# logs
*.log
logs/

# editors / ides
.vscode/
.idea/
*.swp
*~
.claude/

# os clutter
Thumbs.db
desktop.ini
.DS_Store
