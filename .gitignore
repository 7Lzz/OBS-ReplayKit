# python
__pycache__/
*.py[cod]
*$py.class

# dotnet build outputs (ReplayKitSetup and ReplayKitHelper, the c# ports)
ReplayKitSetup/bin/
ReplayKitSetup/obj/
ReplayKitHelper/bin/
ReplayKitHelper/obj/

# build outputs (build.bat publishes ReplayKitSetup into the repo root as a single merged exe, same spot the old pyinstaller build used; publish_helper_tmp is the equivalent scratch dir for the ReplayKitHelper step, normally self-cleaned but ignored too in case a build fails partway through)
build/
dist/
publish_tmp/
publish_helper_tmp/
/OBSReplayKit.exe
/OBSReplayKit.exe.sha256
/prefs.json
/test_update_mode.bat
*.spec

# private pyinstaller build with a locally-compiled bootloader, see build.bat -- rebuilt once per
# machine from pypi source, not committed, and never touches the shared global python environment
/utils/pyinstaller_local/

# regenerated from ReplayKitSetup/VersionInfo.cs by build.bat and by the installer at apply time -- not tracked so a version bump only ever touches VersionInfo.cs
/assets/obs-studio/obs-replayKit/version.json

# one-off smoke / scratch scripts
_smoke_test.py
scratch_*.py

# runtime state written by the installer or helper -- these live in the users appdata, but in case someone copies them into the repo by mistake, ignore them so credentials/cookie stores/per-user paths can never accidentally be committed.
helper_config.json
clips_db.json
auth.jar
cookies.txt
hotkey_capture_signal.json
*.session
.env
.env.local

# custom app icons the user imports at runtime (converted .ico), written under the live icons/ folder -- per-user, not repo content
assets/obs-studio/obs-replayKit/icons/user/
# custom themes the user saves at runtime -- per-user
assets/obs-studio/obs-replayKit/themes-user/
# theme stylesheet the helper generates for the file:// dock -- runtime, per-user
assets/obs-studio/obs-replayKit/obs-custom-dock/rk-theme.css

# backups created by the installer + cleanup script
obs-studio.bak.*/
obs-custom-dock.bak.*/

# logs
*.log
logs/

# editors / ides
.vscode/
.idea/
*.swp
*~
.claude/

# os clutter
Thumbs.db
desktop.ini
.DS_Store
