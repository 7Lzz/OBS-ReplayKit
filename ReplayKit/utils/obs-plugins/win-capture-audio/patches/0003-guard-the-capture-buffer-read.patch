-void Mixer::SubmitPacket(UINT64 timestamp, float *data, UINT32 num_frames)
+// the buffer of a capture client belongs to the audio service, which can take it away in the middle of a read when the captured program dies or the device changes; that is an access violation in the reading thread, and left alone it takes obs down with it. only a fault inside the buffer being read is taken here, so memory trouble anywhere else still shows up as the crash it is
+static int EngineBufferFault(const EXCEPTION_POINTERS *info, const void *begin, const void *end)
 {
-	auto lock = input_section.lock();
+	const EXCEPTION_RECORD *record = info->ExceptionRecord;
+
+	if (record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION && record->ExceptionCode != EXCEPTION_IN_PAGE_ERROR)
+		return EXCEPTION_CONTINUE_SEARCH;
+
+	if (record->NumberParameters < 2)
+		return EXCEPTION_CONTINUE_SEARCH;
+
+	auto address = record->ExceptionInformation[1];
+	if (address < reinterpret_cast<ULONG_PTR>(begin) || address >= reinterpret_cast<ULONG_PTR>(end))
+		return EXCEPTION_CONTINUE_SEARCH;
+
+	return EXCEPTION_EXECUTE_HANDLER;
+}
+
+// nothing with a destructor may stand between the read and this handler: the plugin is not built with /EHa, so a frame in between would not be unwound
+static bool CopyFromEngineBuffer(void *dst, const void *src, std::size_t bytes)
+{
+	__try {
+		memcpy(dst, src, bytes);
+		return true;
+	} __except (EngineBufferFault(GetExceptionInformation(), src, static_cast<const char *>(src) + bytes)) {
+		return false;
+	}
+}
 
-	auto &[_, buffer] = input_queue.emplace(timestamp, 0);
-	buffer.assign(data, data + num_frames * format.nChannels);
+bool Mixer::SubmitPacket(UINT64 timestamp, float *data, UINT32 num_frames)
+{
+	// the copy is made before the lock is taken: reading the buffer of the audio service is the slow part, and the part that can fail
+	std::vector<float> buffer(static_cast<std::size_t>(num_frames) * format.nChannels);
+	if (buffer.empty())
+		return true;
 
+	if (!CopyFromEngineBuffer(buffer.data(), data, buffer.size() * sizeof(float)))
+		return false;
+
+	auto lock = input_section.lock();
+	input_queue.emplace(timestamp, std::move(buffer));
 	lock.reset();
+
+	return true;
 }
 
 static void CALLBACK post_tick(PVOID param, BOOLEAN)
