<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by scripts/sync_version.ps1 from version.json before release builds. -->
  <Import Project="..\..\Version.props" Condition="Exists('..\..\Version.props')" />
  <!-- the plugin zip names of the bundle, written by scripts/sync_shared.ps1 from shared/BundleLayout.cs -->
  <Import Project="..\..\Bundle.props" Condition="Exists('..\..\Bundle.props')" />
  <PropertyGroup>
    <!-- .net framework 4.8 is part of windows (and the helper already needs it), so no runtime ships with the setup; it stays one exe without ilrepack: newtonsoft is compiled from its pinned source into this assembly and webview2 is called thru WebView2Com.cs, with its loader dll as a resource -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ReplayKitSetup</RootNamespace>
    <AssemblyName>OBSReplayKit</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- must stay x64, not AnyCPU: VoiceMeeter.cs loads VoicemeeterRemote64.dll, which a 32-bit process cannot load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\..\lua\helper\obs-replaykit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- nothing may land beside the exe: no binding redirects, so no OBSReplayKit.exe.config, and no xml docs -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- CS8632, CS1574 and CS3021: the newtonsoft source carries nullable annotations, xml doc references and clscompliant marks meant for its own project settings -->
    <NoWarn>$(NoWarn);CS8632;CS1574;CS1591;CS3021</NoWarn>
    <!-- line numbers still land in the crash log without a loose .pdb file next to the exe. -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/ReplayKitSetup</PathMap>
    <!-- Product metadata for the installer. -->
    <Product>OBS ReplayKit</Product>
    <Company>OBS ReplayKit</Company>
    <Description>OBS ReplayKit installer and updater</Description>
    <Copyright>Copyright (c) OBS ReplayKit contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- the modern setup + uninstall window html, loaded via NavigateToString from SetupWindow.cs / UninstallWindow.cs -->
    <EmbeddedResource Include="setup_installer.html" LogicalName="ReplayKitSetup.setup_installer.html" />
    <EmbeddedResource Include="uninstall_prompt.html" LogicalName="ReplayKitSetup.uninstall_prompt.html" />
    <!-- the page runtime that renders the messages SetupLocale.cs puts in front of it; the same file the helper puts in every page it serves -->
    <EmbeddedResource Include="..\..\ui\_i18n.html" Link="_i18n.html" LogicalName="ReplayKitSetup._i18n.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- the C# both programs compile; the helper lists the same folder in its csproj -->
    <Compile Include="..\..\shared\*.cs" Link="shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- the plain version of version.json for VersionInfo.cs, since the informational version gets the git commit appended -->
    <AssemblyMetadata Include="ReplayKitVersion" Value="$(Version)" />
  </ItemGroup>
  <Target Name="RequireVersionProps" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\Version.props')" Text="Version.props is missing -- scripts/sync_version.ps1 writes it from version.json, and build.bat runs that first." />
  </Target>

  <ItemGroup>
    <!-- framework assemblies past the ones the sdk references by default -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="Microsoft.CSharp" />
    <!-- only for WebView2Loader.dll, which becomes a resource; none of the package's assemblies or build files are used -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="ReplayKitSetup.WebView2Loader.dll" />
  </ItemGroup>

  <!-- newtonsoft.json 13.0.3 from its source at the pinned commit (scripts/newtonsoft_source.ps1 checks it out), with the defines its own project gives the net45 build, which is the build nuget hands a .net framework 4.8 app -->
  <PropertyGroup>
    <NewtonsoftSourceDir>$(LOCALAPPDATA)\ReplayKit\newtonsoft-src-13.0.3\Src\Newtonsoft.Json\</NewtonsoftSourceDir>
    <DefineConstants>$(DefineConstants);HAVE_ADO_NET;HAVE_APP_DOMAIN;HAVE_ASYNC;HAVE_BIG_INTEGER;HAVE_BINARY_FORMATTER;HAVE_BINARY_SERIALIZATION;HAVE_BINARY_EXCEPTION_SERIALIZATION;HAVE_CAS;HAVE_CHAR_TO_LOWER_WITH_CULTURE;HAVE_CHAR_TO_STRING_WITH_CULTURE;HAVE_COM_ATTRIBUTES;HAVE_COMPONENT_MODEL;HAVE_CONCURRENT_COLLECTIONS;HAVE_COVARIANT_GENERICS;HAVE_DATA_CONTRACTS;HAVE_DATE_TIME_OFFSET;HAVE_DB_NULL_TYPE_CODE;HAVE_DYNAMIC;HAVE_EMPTY_TYPES;HAVE_ENTITY_FRAMEWORK;HAVE_EXPRESSIONS;HAVE_FAST_REVERSE;HAVE_FSHARP_TYPES;HAVE_FULL_REFLECTION;HAVE_GUID_TRY_PARSE;HAVE_HASH_SET;HAVE_ICLONEABLE;HAVE_ICONVERTIBLE;HAVE_IGNORE_DATA_MEMBER_ATTRIBUTE;HAVE_INOTIFY_COLLECTION_CHANGED;HAVE_INOTIFY_PROPERTY_CHANGING;HAVE_ISET;HAVE_LINQ;HAVE_MEMORY_BARRIER;HAVE_METHOD_IMPL_ATTRIBUTE;HAVE_NON_SERIALIZED_ATTRIBUTE;HAVE_READ_ONLY_COLLECTIONS;HAVE_REFLECTION_EMIT;HAVE_REGEX_TIMEOUTS;HAVE_SECURITY_SAFE_CRITICAL_ATTRIBUTE;HAVE_SERIALIZATION_BINDER_BIND_TO_NAME;HAVE_STREAM_READER_WRITER_CLOSE;HAVE_STRING_JOIN_WITH_ENUMERABLE;HAVE_TIME_SPAN_PARSE_WITH_CULTURE;HAVE_TIME_SPAN_TO_STRING_WITH_CULTURE;HAVE_TIME_ZONE_INFO;HAVE_TRACE_WRITER;HAVE_TYPE_DESCRIPTOR;HAVE_UNICODE_SURROGATE_DETECTION;HAVE_VARIANT_TYPE_PARAMETERS;HAVE_VERSION_TRY_PARSE;HAVE_XLINQ;HAVE_XML_DOCUMENT;HAVE_XML_DOCUMENT_TYPE;HAVE_CONCURRENT_DICTIONARY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NewtonsoftSourceDir)**\*.cs" Exclude="$(NewtonsoftSourceDir)Properties\**;$(NewtonsoftSourceDir)obj\**;$(NewtonsoftSourceDir)bin\**" Link="newtonsoft\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireNewtonsoftSource" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NewtonsoftSourceDir)JsonConvert.cs')" Text="The Newtonsoft.Json source is missing; scripts/newtonsoft_source.ps1 checks it out at the pinned commit, and build.bat runs it first." />
  </Target>

  <PropertyGroup>
    <!-- the payload ships inside the exe as one zip resource, unpacked at runtime by AssetBundle.cs; the auto-updater only fetches OBSReplayKit.exe, so a payload living anywhere else closes obs and then finds nothing to install. staged into obj\ first because the working tree can hold per-user runtime folders (imported icons, saved themes) that must never ship. -->
    <RepoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepoDir>
    <!-- obj\ spelled out rather than $(IntermediateOutputPath): this target runs before PrepareForBuild, where that property is not resolved yet and the staging would land in the project folder. -->
    <AssetBundleStageDir>$(MSBuildProjectDirectory)\obj\assets-bundle\</AssetBundleStageDir>
    <AssetBundleZip>$(MSBuildProjectDirectory)\obj\assets.bundle.zip</AssetBundleZip>
    <AssetZipStageDir>$(MSBuildProjectDirectory)\obj\assets-zips\</AssetZipStageDir>
  </PropertyGroup>

  <Target Name="PackAssetBundle" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <!-- per-user runtime files that can turn up in the working tree and must never ship, whichever folder they land in -->
      <AssetBundleExclude>$(RepoDir)resources\icons\user\**\*;$(RepoDir)**\themes-user\**\*;$(RepoDir)**\game-icons\**\*;$(RepoDir)ui\rk-theme.css;$(RepoDir)**\*.pdb;$(RepoDir)**\*.log;$(RepoDir)**\auth.dat;$(RepoDir)**\auth_cookies.txt;$(RepoDir)**\cookies.txt;$(RepoDir)**\helper_config.json;$(RepoDir)**\clips_db.json;$(RepoDir)**\clips_index.json;$(RepoDir)**\edit_drafts.json;$(RepoDir)**\deleted_history.json;$(RepoDir)**\profile_picture.png;$(RepoDir)**\share_cover_*;$(RepoDir)**\game_mappings.json;$(RepoDir)**\notifications.json;$(RepoDir)**\window_state.ini;$(RepoDir)**\hotkey_capture_signal.json;$(RepoDir)**\auth.jar;$(RepoDir)**\.env;$(RepoDir)**\.env.*;$(RepoDir)**\*.session</AssetBundleExclude>
    </PropertyGroup>
    <!-- where each repo folder lands inside the bundle. the bundle layout is what the installer and the updater of every earlier release read (obs-studio\ mirrors %APPDATA%\obs-studio\), so only the left side of this map ever changes -->
    <ItemGroup>
      <AssetBundleFile Include="$(RepoDir)ui\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\obs-custom-dock\" />
      <AssetBundleFile Include="$(RepoDir)lua\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\scripts\" />
      <AssetBundleFile Include="$(RepoDir)dist\helper\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\scripts\helper\" />
      <AssetBundleFile Include="$(RepoDir)dist\share-window\ReplayKitShare.exe" BundleDir="obs-studio\$(ReplayKitFolder)\share-window\" />
      <AssetBundleFile Include="$(RepoDir)resources\icons\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\icons\" />
      <AssetBundleFile Include="$(RepoDir)resources\fonts\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\fonts\" />
      <AssetBundleFile Include="$(RepoDir)resources\sounds\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\sounds\" />
      <AssetBundleFile Include="$(RepoDir)resources\data\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\$(ReplayKitFolder)\data\" />
      <AssetBundleFile Include="$(RepoDir)config\replaykit_settings.json;$(RepoDir)dist\version.json" BundleDir="obs-studio\$(ReplayKitFolder)\" />
      <AssetBundleFile Include="$(RepoDir)config\obs\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\" />
      <AssetBundleFile Include="$(RepoDir)config\obs-versions.json;$(RepoDir)plugins\obs-shaderfilter\$(ShaderfilterZip)" BundleDir="" />
      <AssetBundleFile Include="$(RepoDir)dist\replaykit.dll" BundleDir="obs-plugins\replaykit\bin\64bit\" />
    </ItemGroup>
    <Error Condition="'$(BangoCatZipPrefix)' == '' Or '$(ShaderfilterZip)' == '' Or '$(ReplayKitFolder)' == ''" Text="Bundle.props is missing or incomplete -- scripts/sync_shared.ps1 writes it, and build.bat runs that first." />
    <Error Condition="!Exists('$(RepoDir)dist\version.json') Or !Exists('$(RepoDir)dist\replaykit.dll') Or !Exists('$(RepoDir)dist\helper\OBSReplayKit.exe')" Text="A built part of the payload is missing from dist\ -- run build.bat so the release exe does not ship without it." />
    <Error Condition="!Exists('$(RepoDir)dist\input-overlay\input-overlay.dll') Or !Exists('$(RepoDir)dist\input-overlay\SDL3.dll') Or !Exists('$(RepoDir)dist\input-overlay\uiohook.dll')" Text="The input-overlay build is missing its plugin or runtime dependencies." />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <Copy SourceFiles="@(AssetBundleFile)" DestinationFiles="@(AssetBundleFile->'$(AssetBundleStageDir)%(BundleDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec Command="python -B &quot;$(RepoDir)tools\i18n\messages.py&quot; --output &quot;$(AssetBundleStageDir)obs-studio\$(ReplayKitFolder)\locale\messages&quot; --dock &quot;$(AssetBundleStageDir)obs-studio\$(ReplayKitFolder)\obs-custom-dock&quot;" />
    <!-- the process host sits flat in dist\process-host\<version>\; its manifest says where each file installs, and the bundle keeps that layout -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoDir)scripts\stage_process_host.ps1&quot; -Stage &quot;$(AssetBundleStageDir)process-host-roles&quot;" />
    <!-- plugin files are kept loose in the repo and zipped here by the names and folders of shared/BundleLayout.cs, the same constants the installer reads them back with -->
    <ItemGroup>
      <BangoCatFile Include="$(RepoDir)plugins\bango-cat\**\*" />
      <!-- the alternative mice are paint.net sources and previews no layout of shared/InputOverlayLayout.cs uses, so they stay in the vendor folder and out of the release -->
      <PresetFile Include="$(RepoDir)vendor\input-overlay-presets\**\*" Exclude="$(RepoDir)vendor\input-overlay-presets\mouse\alternative\**\*" />
      <WinCaptureDll Include="$(RepoDir)dist\win-capture-audio\$(WinCaptureAudioDll)" />
      <WinCaptureData Include="$(RepoDir)dist\win-capture-audio\**\*" Exclude="$(RepoDir)dist\win-capture-audio\$(WinCaptureAudioDll)" />
      <InputOverlayFile Include="$(RepoDir)dist\input-overlay\**\*" />
      <VbCableFile Include="$(RepoDir)vendor\vb-cable\$(VbCablePack)" />
    </ItemGroup>
    <Error Condition="'@(BangoCatFile)' == '' Or '@(PresetFile)' == '' Or '@(WinCaptureData)' == '' Or '@(InputOverlayFile)' == '' Or !Exists('$(RepoDir)dist\win-capture-audio\$(WinCaptureAudioDll)') Or !Exists('$(RepoDir)dist\input-overlay\input-overlay.dll') Or !Exists('$(RepoDir)vendor\vb-cable\$(VbCablePack)')" Text="A plugin folder the release zips is missing or empty -- the release exe would ship without it." />
    <RemoveDir Directories="$(AssetZipStageDir)" />
    <Copy SourceFiles="@(BangoCatFile)" DestinationFiles="@(BangoCatFile->'$(AssetZipStageDir)bango-cat\$(BangoCatZipPrefix)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PresetFile)" DestinationFiles="@(PresetFile->'$(AssetZipStageDir)presets\$(PresetsZipRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)bango-cat" DestinationFile="$(AssetBundleStageDir)$(BangoCatZip)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)presets" DestinationFile="$(AssetBundleStageDir)$(PresetsZip)" Overwrite="true" />
    <Copy SourceFiles="@(WinCaptureDll)" DestinationFolder="$(AssetZipStageDir)wca\$(WinCaptureAudioDllDir)" />
    <Copy SourceFiles="@(WinCaptureData)" DestinationFiles="@(WinCaptureData->'$(AssetZipStageDir)wca\$(WinCaptureAudioDataDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(InputOverlayFile)" DestinationFiles="@(InputOverlayFile->'$(AssetZipStageDir)overlay\$(InputOverlayZipRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(VbCableFile)" DestinationFolder="$(AssetZipStageDir)installers\" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)wca" DestinationFile="$(AssetBundleStageDir)$(WinCaptureAudioZip)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)overlay" DestinationFile="$(AssetBundleStageDir)$(InputOverlayZip)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)installers" DestinationFile="$(AssetBundleStageDir)$(InstallersZip)" Overwrite="true" />
    <RemoveDir Directories="$(AssetZipStageDir)" />
    <ZipDirectory SourceDirectory="$(AssetBundleStageDir)" DestinationFile="$(AssetBundleZip)" Overwrite="true" />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <ItemGroup>
      <EmbeddedResource Include="$(AssetBundleZip)" LogicalName="ReplayKitSetup.assets.bundle.zip" />
    </ItemGroup>
  </Target>
</Project>
