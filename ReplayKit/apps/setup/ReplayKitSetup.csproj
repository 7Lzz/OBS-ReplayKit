<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by scripts/sync_version.ps1 from version.json before release builds. -->
  <Import Project="..\..\Version.props" Condition="Exists('..\..\Version.props')" />
  <!-- the plugin zip names of the bundle, written by scripts/sync_shared.ps1 from shared/BundleLayout.cs -->
  <Import Project="..\..\Bundle.props" Condition="Exists('..\..\Bundle.props')" />
  <PropertyGroup>
    <!-- WinExe, no windowing framework: the installer window is drawn with raw win32/comctl32 (InstallerWindow.cs) so trimming stays on. UseWindowsForms/UseWPF are hard-blocked with PublishTrimmed (NETSDK1175), and self-contained they would drag the whole ~50 mb WindowsDesktop runtime + loose native dlls into what must be one small file. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ReplayKitSetup</RootNamespace>
    <AssemblyName>OBSReplayKit</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- must stay x64, not AnyCPU: VoiceMeeter.cs loads VoicemeeterRemote64.dll, which a 32-bit process cannot load. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\..\lua\helper\obs-replaykit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Runtime, managed dependencies, and assets are contained in the installer. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- pull the native WebView2Loader.dll into the single file (self-extracted at startup) so the release stays exe plus checksums only; the auto-updater fetches nothing else. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- no xml doc files copied next to the exe (WebView2 ships large ones). -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- partial trim takes the exe from ~44 mb to ~24 mb. it only trims bcl assemblies that opt in; Newtonsoft.Json, ServiceController and Registry are root-kept below so their reflection/interop paths stay whole. the ~5 wmi sites were already moved off System.Management (registry + Process api), so nothing here needs full trim. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- library-origin trim warnings, none of it reachable code here: IL2104 = Newtonsoft.Json produced warnings (partial trim leaves it whole anyway), IL2026 = the System.Data DataSet/DataTable xml paths Newtonsoft drags in plus the built-in COM activator. the WScript.Shell late-bound COM in Startup.cs carries its own suppress. -->
    <!-- MSB3277: the WebView2 package's WPF wrapper references WindowsBase 5.0.0.0; DropUnusedWebView2Wrappers keeps that wrapper out of the output, but the warning still fires during RAR. expected + harmless here. -->
    <NoWarn>$(NoWarn);IL2104;IL2026;MSB3277</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- no icu. this project has zero CultureInfo use and only ever compares/formats invariant ascii (obs config keys, file paths, version strings), so dropping the ~24 mb icu payload is behaviour-neutral here. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- diagnostic infrastructure an installer never uses. shaves a few mb and does not touch exception messages or stack traces, both of which Program.cs writes to OBSReplayKit-error.log for user crash reports. -->
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- line numbers still land in the crash log without a loose .pdb file next to the exe. -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/ReplayKitSetup</PathMap>
    <!-- Product metadata for the installer. -->
    <Product>OBS ReplayKit</Product>
    <Company>OBS ReplayKit</Company>
    <Description>OBS ReplayKit installer and updater</Description>
    <Copyright>Copyright (c) OBS ReplayKit contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- the modern setup + uninstall window html, loaded via NavigateToString from SetupWindow.cs / UninstallWindow.cs -->
    <EmbeddedResource Include="setup_installer.html" LogicalName="ReplayKitSetup.setup_installer.html" />
    <EmbeddedResource Include="uninstall_prompt.html" LogicalName="ReplayKitSetup.uninstall_prompt.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- the C# both programs compile; the helper lists the same folder in its csproj -->
    <Compile Include="..\..\shared\*.cs" Link="shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- the plain version of version.json for VersionInfo.cs, since the informational version gets the git commit appended -->
    <AssemblyMetadata Include="ReplayKitVersion" Value="$(Version)" />
  </ItemGroup>
  <Target Name="RequireVersionProps" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\Version.props')" Text="Version.props is missing -- scripts/sync_version.ps1 writes it from version.json, and build.bat runs that first." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- windows-only, not in the net8 shared framework; backs VbCable.cs's AudioEndpointBuilder/Audiosrv bounce. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <!-- raw-win32 CoreWebView2 host for the modern setup window (SetupWindow.cs). only Microsoft.Web.WebView2.Core.dll plus the native WebView2Loader.dll are pulled in; the WinForms/WPF wrappers are gated on UseWindowsForms / UseWPF, both off here. the evergreen runtime is downloaded by WebView2Runtime.cs when missing. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- keep whole under trimming: the linker cannot see through Newtonsoft's reflection, and ServiceController plus Registry are small advapi32-interop assemblies where a trimmed member would only surface at runtime mid-install. WebView2.Core is com-interop heavy and its trimmed members would only fault at runtime when the window loads. -->
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="System.ServiceProcess.ServiceController" />
    <TrimmerRootAssembly Include="Microsoft.Win32.Registry" />
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" />
  </ItemGroup>

  <!-- SetupWindow.cs hosts the raw CoreWebView2 controller directly; the WinForms + WPF wrapper assemblies from the package are unused and the WPF one drags a conflicting WindowsBase into the trimmed single file. drop both. -->
  <Target Name="DropUnusedWebView2Wrappers" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)"
        Condition="'%(FileName)' == 'Microsoft.Web.WebView2.WinForms' or '%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(FileName)' == 'Microsoft.Web.WebView2.WinForms' or '%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferencePath Remove="@(ReferencePath)"
        Condition="'%(FileName)' == 'Microsoft.Web.WebView2.WinForms' or '%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <!-- the payload ships inside the exe as one zip resource, unpacked at runtime by AssetBundle.cs; the auto-updater only fetches OBSReplayKit.exe, so a payload living anywhere else closes obs and then finds nothing to install. staged into obj\ first because the working tree can hold per-user runtime folders (imported icons, saved themes) that must never ship. -->
    <RepoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepoDir>
    <!-- obj\ spelled out rather than $(IntermediateOutputPath): this target runs before PrepareForBuild, where that property is not resolved yet and the staging would land in the project folder. -->
    <AssetBundleStageDir>$(MSBuildProjectDirectory)\obj\assets-bundle\</AssetBundleStageDir>
    <AssetBundleZip>$(MSBuildProjectDirectory)\obj\assets.bundle.zip</AssetBundleZip>
    <AssetZipStageDir>$(MSBuildProjectDirectory)\obj\assets-zips\</AssetZipStageDir>
  </PropertyGroup>

  <Target Name="PackAssetBundle" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <!-- per-user runtime files that can turn up in the working tree and must never ship, whichever folder they land in -->
      <AssetBundleExclude>$(RepoDir)resources\icons\user\**\*;$(RepoDir)**\themes-user\**\*;$(RepoDir)**\game-icons\**\*;$(RepoDir)ui\rk-theme.css;$(RepoDir)**\*.pdb;$(RepoDir)**\*.log;$(RepoDir)**\auth.dat;$(RepoDir)**\auth_cookies.txt;$(RepoDir)**\cookies.txt;$(RepoDir)**\helper_config.json;$(RepoDir)**\clips_db.json;$(RepoDir)**\clips_index.json;$(RepoDir)**\edit_drafts.json;$(RepoDir)**\deleted_history.json;$(RepoDir)**\profile_picture.png;$(RepoDir)**\game_mappings.json;$(RepoDir)**\notifications.json;$(RepoDir)**\window_state.ini;$(RepoDir)**\hotkey_capture_signal.json;$(RepoDir)**\auth.jar;$(RepoDir)**\.env;$(RepoDir)**\.env.*;$(RepoDir)**\*.session</AssetBundleExclude>
    </PropertyGroup>
    <!-- where each repo folder lands inside the bundle. the bundle layout is what the installer and the updater of every earlier release read (obs-studio\ mirrors %APPDATA%\obs-studio\), so only the left side of this map ever changes -->
    <ItemGroup>
      <AssetBundleFile Include="$(RepoDir)ui\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\obs-replayKit\obs-custom-dock\" />
      <AssetBundleFile Include="$(RepoDir)lua\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\obs-replayKit\scripts\" />
      <AssetBundleFile Include="$(RepoDir)dist\helper\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\obs-replayKit\scripts\helper\" />
      <AssetBundleFile Include="$(RepoDir)resources\icons\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\obs-replayKit\icons\" />
      <AssetBundleFile Include="$(RepoDir)resources\fonts\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\obs-replayKit\fonts\" />
      <AssetBundleFile Include="$(RepoDir)resources\data\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\obs-replayKit\data\" />
      <AssetBundleFile Include="$(RepoDir)config\replaykit_settings.json;$(RepoDir)dist\version.json" BundleDir="obs-studio\obs-replayKit\" />
      <AssetBundleFile Include="$(RepoDir)config\obs\**\*" Exclude="$(AssetBundleExclude)" BundleDir="obs-studio\" />
      <AssetBundleFile Include="$(RepoDir)config\obs-versions.json;$(RepoDir)plugins\obs-shaderfilter\$(ShaderfilterZip)" BundleDir="" />
      <AssetBundleFile Include="$(RepoDir)dist\replaykit.dll" BundleDir="obs-plugins\replaykit\bin\64bit\" />
    </ItemGroup>
    <Error Condition="'$(BangoCatZipPrefix)' == '' Or '$(ShaderfilterZip)' == ''" Text="Bundle.props is missing or incomplete -- scripts/sync_shared.ps1 writes it, and build.bat runs that first." />
    <Error Condition="!Exists('$(RepoDir)dist\version.json') Or !Exists('$(RepoDir)dist\replaykit.dll') Or !Exists('$(RepoDir)dist\helper\OBSReplayKit.exe')" Text="A built part of the payload is missing from dist\ -- run build.bat so the release exe does not ship without it." />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <Copy SourceFiles="@(AssetBundleFile)" DestinationFiles="@(AssetBundleFile->'$(AssetBundleStageDir)%(BundleDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- the process host sits flat in dist\process-host\<version>\; its manifest says where each file installs, and the bundle keeps that layout -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoDir)scripts\stage_process_host.ps1&quot; -Stage &quot;$(AssetBundleStageDir)process-host-roles&quot;" />
    <!-- plugin files are kept loose in the repo and zipped here by the names and folders of shared/BundleLayout.cs, the same constants the installer reads them back with -->
    <ItemGroup>
      <BangoCatFile Include="$(RepoDir)plugins\bango-cat\**\*" />
      <PresetFile Include="$(RepoDir)vendor\input-overlay-presets\**\*" />
      <WinCaptureDll Include="$(RepoDir)dist\win-capture-audio\$(WinCaptureAudioDll)" />
      <WinCaptureData Include="$(RepoDir)dist\win-capture-audio\**\*" Exclude="$(RepoDir)dist\win-capture-audio\$(WinCaptureAudioDll)" />
      <InputOverlayFile Include="$(RepoDir)dist\input-overlay\**\*" />
      <VbCableFile Include="$(RepoDir)vendor\vb-cable\$(VbCablePack)" />
    </ItemGroup>
    <Error Condition="'@(BangoCatFile)' == '' Or '@(PresetFile)' == '' Or '@(WinCaptureData)' == '' Or '@(InputOverlayFile)' == '' Or !Exists('$(RepoDir)dist\win-capture-audio\$(WinCaptureAudioDll)') Or !Exists('$(RepoDir)dist\input-overlay\input-overlay.dll') Or !Exists('$(RepoDir)vendor\vb-cable\$(VbCablePack)')" Text="A plugin folder the release zips is missing or empty -- the release exe would ship without it." />
    <RemoveDir Directories="$(AssetZipStageDir)" />
    <Copy SourceFiles="@(BangoCatFile)" DestinationFiles="@(BangoCatFile->'$(AssetZipStageDir)bango-cat\$(BangoCatZipPrefix)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PresetFile)" DestinationFiles="@(PresetFile->'$(AssetZipStageDir)presets\$(PresetsZipRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)bango-cat" DestinationFile="$(AssetBundleStageDir)$(BangoCatZip)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)presets" DestinationFile="$(AssetBundleStageDir)$(PresetsZip)" Overwrite="true" />
    <Copy SourceFiles="@(WinCaptureDll)" DestinationFolder="$(AssetZipStageDir)wca\$(WinCaptureAudioDllDir)" />
    <Copy SourceFiles="@(WinCaptureData)" DestinationFiles="@(WinCaptureData->'$(AssetZipStageDir)wca\$(WinCaptureAudioDataDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(InputOverlayFile)" DestinationFiles="@(InputOverlayFile->'$(AssetZipStageDir)overlay\$(InputOverlayZipRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(VbCableFile)" DestinationFolder="$(AssetZipStageDir)installers\" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)wca" DestinationFile="$(AssetBundleStageDir)$(WinCaptureAudioZip)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)overlay" DestinationFile="$(AssetBundleStageDir)$(InputOverlayZip)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(AssetZipStageDir)installers" DestinationFile="$(AssetBundleStageDir)$(InstallersZip)" Overwrite="true" />
    <RemoveDir Directories="$(AssetZipStageDir)" />
    <ZipDirectory SourceDirectory="$(AssetBundleStageDir)" DestinationFile="$(AssetBundleZip)" Overwrite="true" />
    <RemoveDir Directories="$(AssetBundleStageDir)" />
    <ItemGroup>
      <EmbeddedResource Include="$(AssetBundleZip)" LogicalName="ReplayKitSetup.assets.bundle.zip" />
    </ItemGroup>
  </Target>
</Project>
