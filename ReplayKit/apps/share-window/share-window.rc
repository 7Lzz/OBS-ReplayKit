#include <winver.h>

1 ICON "replaykit.ico"
OBS_SWIRL_MASK RCDATA "share/obs-swirl-mask.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION REPLAYKIT_VERSION_COMMA
PRODUCTVERSION REPLAYKIT_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OBS ReplayKit"
            VALUE "FileDescription", "OBS ReplayKit Share Window"
            VALUE "FileVersion", REPLAYKIT_VERSION
            VALUE "InternalName", "ReplayKitShare"
            VALUE "OriginalFilename", "ReplayKitShare.exe"
            VALUE "ProductName", "OBS ReplayKit"
            VALUE "ProductVersion", REPLAYKIT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
