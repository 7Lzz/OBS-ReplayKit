Track packet continuity independently for each WASAPI process-loopback stream.

Align small timestamp deviations to the previous packet's end, keep gaps across real discontinuities, and trim larger overlaps before summing separate streams.

diff --git a/src/packet-timeline.hpp b/src/packet-timeline.hpp
new file mode 100644
--- /dev/null
+++ b/src/packet-timeline.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+struct PacketPlacement {
+	std::uint64_t timestamp;
+	std::uint32_t skip;
+};
+
+class PacketTimeline {
+	static constexpr std::uint64_t ticks_per_second = 10'000'000;
+	std::uint64_t next_frame = 0;
+	bool continuous = false;
+
+public:
+	void MarkGap() { continuous = false; }
+
+	PacketPlacement Place(std::uint64_t timestamp, std::uint32_t frames, std::uint32_t rate,
+			      bool discontinuity)
+	{
+		// use a common qpc frame grid so independent captures keep the same sample phase
+		auto frame = timestamp / ticks_per_second * rate +
+			     (timestamp % ticks_per_second * rate + ticks_per_second / 2) / ticks_per_second;
+		auto distance = frame >= next_frame ? frame - next_frame : next_frame - frame;
+		const auto tolerance = (std::min)(rate / 500, (frames - 1) / 2);
+		if (continuous && !discontinuity && distance <= tolerance)
+			frame = next_frame;
+
+		std::uint32_t skip = 0;
+		if (frame < next_frame) {
+			auto overlap = next_frame - frame;
+			if (overlap >= frames)
+				return {timestamp, frames};
+			skip = static_cast<std::uint32_t>(overlap);
+			frame = next_frame;
+		}
+
+		next_frame = frame + frames - skip;
+		continuous = true;
+		return {frame / rate * ticks_per_second + frame % rate * ticks_per_second / rate, skip};
+	}
+};
