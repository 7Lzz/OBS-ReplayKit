+static bool OutputDeviceMonitoringEnabled(const obs_source_t *source)
+{
+	// obs 33 logs a warning on each call to the old monitoring getter
+	using GetMonitoringEnabled = bool (*)(const obs_source_t *);
+	static const auto enabled = reinterpret_cast<GetMonitoringEnabled>(
+		GetProcAddress(GetModuleHandleW(L"obs.dll"), "obs_source_get_monitoring_enabled"));
+	return enabled ? enabled(source)
+		       : obs_source_get_monitoring_type(source) != OBS_MONITORING_TYPE_NONE;
+}
+
+static void ForwardOutputDevice(void *context, obs_source_t *, const struct audio_data *packet, bool muted)
+{
+	auto *target = static_cast<obs_source_t *>(context);
+	// don't let the endpoint mix feed back to speakers or the share cable
+	if (muted || OutputDeviceMonitoringEnabled(target))
+		return;
+
+	obs_audio_info format{};
+	if (!obs_get_audio_info(&format))
+		return;
+
+	obs_source_audio audio{};
+	for (size_t i = 0; i < get_audio_channels(format.speakers); ++i)
+		audio.data[i] = packet->data[i];
+	audio.frames = packet->frames;
+	audio.speakers = format.speakers;
+	audio.format = AUDIO_FORMAT_FLOAT_PLANAR;
+	audio.samples_per_sec = format.samples_per_sec;
+	audio.timestamp = packet->timestamp;
+	obs_source_output_audio(target, &audio);
+}
+
+void AudioCapture::StartOutputDevice(const std::string &device)
+{
+	StopOutputDevice();
+	auto *settings = obs_data_create();
+	obs_data_set_string(settings, "device_id", device.c_str());
+	device_source = obs_source_create_private("wasapi_output_capture", "ReplayKit output device", settings);
+	obs_data_release(settings);
+	if (!device_source) {
+		error("could not create the OBS output device capture");
+		return;
+	}
+
+	active_device = device;
+	obs_source_add_audio_capture_callback(device_source, ForwardOutputDevice, source);
+	obs_source_inc_active(device_source);
+}
+
+void AudioCapture::StopOutputDevice()
+{
+	if (!device_source)
+		return;
+
+	obs_source_remove_audio_capture_callback(device_source, ForwardOutputDevice, source);
+	obs_source_dec_active(device_source);
+	obs_source_release(device_source);
+	device_source = nullptr;
+}
