<Project Sdk="Microsoft.NET.Sdk">
  <!-- generated by utils\sync_version.ps1 (build.bat step 1) from ReplayKitSetup\VersionInfo.cs; gitignored, same
       as version.json. falls back to a plain 0.0.0 build below if this hasnt been generated yet, e.g. a raw
       `dotnet build` that skipped build.bat; the project still compiles, it just wont carry a real version. -->
  <Import Project="..\Version.props" Condition="Exists('..\Version.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReplayKitHelper</RootNamespace>
    <!-- must stay OBSReplayKit; helper_bootstrap.lua looks for this exact filename next to local_helper_server.ps1 and launches it with -ConfigPath if present, falling back to powershell.exe only when it's missing. matching the name means the lua side needs zero changes. -->
    <AssemblyName>OBSReplayKit</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- runs at whatever privilege obs itself launched at; never elevate. this is also why the http listener is a raw TcpListener, not HttpListener/http.sys, which needs a urlacl reservation or admin rights to bind even loopback-only. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Win32 version resource; same reasoning as ReplayKitSetup.csproj's copy of this comment. an unsigned,
         version-less binary is a much easier "generic trojan" call for av heuristics than an unsigned one that at
         least looks like a maintained release. -->
    <Product>OBS ReplayKit</Product>
    <Company>OBS ReplayKit</Company>
    <Description>OBS ReplayKit background helper</Description>
    <Copyright>Copyright (c) OBS ReplayKit contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ILRepackPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedAssemblies Include="$(PublishDir)$(TargetName)$(TargetExt)" />
      <!-- WebView2Loader.dll is a native loader and cannot be merged, same as before. Newtonsoft.Json.dll now ships unmerged too; a merged exe reads as packed to several av heuristics, and build_helper.ps1 already copies it out as a plain sibling file next to the helper. managed WebView2 assemblies still merge into the EXE. -->
      <PublishedAssemblies Include="$(PublishDir)*.dll" Exclude="$(PublishDir)$(TargetName)$(TargetExt);$(PublishDir)WebView2Loader.dll;$(PublishDir)Newtonsoft.Json.dll" />
      <PublishedDllsToRemove Include="$(PublishDir)*.dll" Exclude="$(PublishDir)$(TargetName)$(TargetExt);$(PublishDir)WebView2Loader.dll;$(PublishDir)Newtonsoft.Json.dll" />
    </ItemGroup>
    <ILRepack
        Parallel="true"
        DebugInfo="false"
        AllowDuplicateResources="false"
        InputAssemblies="@(PublishedAssemblies)"
        TargetKind="SameAsPrimaryAssembly"
        OutputFile="$(PublishDir)$(TargetName)$(TargetExt)"
    />
    <Delete Files="@(PublishedDllsToRemove)" />
  </Target>
</Project>
